{
  "name": "wdipt",
  "version": "0.1.0",
  "description": "拾间：用平面图搭建住宅、自动生成 3D 模型，并记住每件物品放在哪里。",
  "type": "module",
  "bin": {
    "wdipt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "home",
    "floor-plan",
    "interior",
    "threejs",
    "fastify",
    "vue",
    "inventory",
    "spatial-memory",
    "sqlite",
    "wdipt"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsdown",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
